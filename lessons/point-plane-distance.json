  "steps": [
    {
      "title": "在平面内找水平线",
      "action": "过 b′ 作水平线，交 a′c′ 得 p′。向下投影到 ac 得 p，连接 bp。",
      "reason": "BP 平行于 H 面。它的水平投影 bp 给出了该水平线的实方向。",
      "add": [
        "horizontal-line"
      ]
    },
    {
      "title": "换面，让 ABC 积聚成直线",
      "action": "在 H 图空白处作 X₁ 垂直于 bp。沿垂直于 X₁ 的投影方向转移各点，距 X₁ 的高度沿用正面投影中的高度。右侧单独绘出辅助视图。",
      "reason": "BP 垂直于新投影面，所以 b₁ 与 p₁ 重合，整个 ABC 积聚为 a₁b₁c₁。EF 的新投影为 e₁f₁。",
      "add": [
        "edge-view"
      ]
    },
    {
      "title": "在线的两侧各偏移 20 mm",
      "action": "在辅助视图中，作两条与 a₁b₁c₁ 平行、垂距均为 20 mm 的线。分别与 e₁f₁ 或其延长线相交。",
      "reason": "ABC 在该视图里积聚成直线，垂直于 ABC 的距离在此视图中显示实长。两侧都要检查。",
      "add": [
        "offset-intersections"
      ],
      "show": [
        "offset-intersections-marks"
      ]
    },
    {
      "title": "回到原来的两面投影",
      "action": "从两个交点分别反投影到原来的 ef 直线，再在 e′f′ 直线上找对应点。必要时延长 EF 的投影。",
      "reason": "也可用辅助视图中交点距 X₁ 的有向高度，在正面图作同一高度的水平线，再向下对正。",
      "show": [
        "original-projections"
      ]
    }
  ],
