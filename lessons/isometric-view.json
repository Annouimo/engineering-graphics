        "column"
      ],
      "show": [
        "column-marks"
      ]
    },
    {
      "title": "检查可见棱线",
      "action": "核对台阶、斜面下缘和柱脚折线。完成图仅画这个观察方向下可见的棱。",
      "reason": "转动观察方向可能看到另一侧的棱。当前方向选择了能看到斜面的一侧。",
      "show": [
        "visibility-check"
      ]
    }
