  "steps": [
    {
      "title": "先补底座",
      "action": "由俯视图定左右边界，由左视图转移底面、台阶、斜面下缘和底座上缘的高度。",
      "reason": "俯视图的外框给出全宽。底座的台阶和斜面都沿全宽延伸。",
      "add": [
        "base-outline"
      ],
      "show": [
        "base-outline-marks"
      ]
    },
    {
      "title": "定位上方的四棱柱",
      "action": "由俯视图的菱形定柱的左右边界和中棱位置，从左视图转移柱顶高度。",
      "reason": "菱形是柱顶轮廓的俯视投影。定了宽度和高度，就能定出主视图中的柱顶和竖棱。",
      "add": [
        "column-outline"
      ],
      "show": [
        "column-outline-marks"
      ]
    },
    {
      "title": "补柱脚与斜面的交线",
      "action": "把左视图斜面上缘的深度转到俯视图，在深度分界线上取与菱形相交的两点，再向上对正。在正面三条投影线上分别找两个转折点与中间低点。",
      "reason": "柱脚在平顶处同高，在斜面上随深度降低。朝前的中棱柱脚最低，形成一条折线。",
      "add": [
        "intersection-edges"
      ],
      "show": [
        "intersection-edges-marks"
      ]
    },
    {
      "title": "按遮挡确定虚实",
      "action": "底座上缘画到柱脚交线。柱后方与底座平顶的交线在正面图中被柱挡住，中段画虚线。",
      "reason": "可见轮廓与不可见棱重合时保留可见实线。",
      "show": [
        "hidden-edges"
      ]
    }
  ],
